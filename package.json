{
  "name": "agripulse-ai",
  "version": "1.0.0",
  "description": "AgriPulse AI - An AI-Powered Precision Agriculture and Crop Disease Advisory System",
  "main": "server/server.js",
  "scripts": {
    "server": "npm run start --prefix server",
    "client": "npm run dev --prefix client",
    "ai_service": "py -m uvicorn ai_service.main:app --reload --port 8000",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install --prefix server && npm install --prefix client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "agriculture",
    "ai",
    "rag",
    "crop-disease",
    "fastapi",
    "react",
    "express"
  ],
  "author": "",
  "license": "ISC"
}
